<?xml version = '1.0' encoding = 'windows-1252'?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5" xmlns="http://java.sun.com/xml/ns/javaee">
  <servlet>
    <servlet-name>Jersey Web Application</servlet-name>
    <servlet-class>com.sun.jersey.spi.container.servlet.ServletContainer</servlet-class>
    <init-param>
      <param-name>com.sun.jersey.config.property.packages</param-name>
      <param-value>edu.ucla.library.libservices.webservices.ecommerce.web.services</param-value>
    </init-param>
    <init-param>
      <param-name>com.sun.ws.rest.config.property.resourceConfigClass</param-name>
      <param-value>com.sun.ws.rest.api.core.PackagesResourceConfig</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>Jersey Web Application</servlet-name>
    <url-pattern>/pdfs/*</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>LoggingServlet</servlet-name>
    <servlet-class>edu.ucla.library.libservices.webservices.ecommerce.web.servlets.LoggingServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>PaymentServlet</servlet-name>
    <servlet-class>edu.ucla.library.libservices.webservices.ecommerce.web.servlets.PaymentServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>TestServlet</servlet-name>
    <servlet-class>edu.ucla.library.libservices.webservices.ecommerce.web.servlets.TestServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>PdfServlet</servlet-name>
    <servlet-class>edu.ucla.library.libservices.webservices.ecommerce.web.servlets.PdfServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>AuthServlet</servlet-name>
    <servlet-class>edu.ucla.library.libservices.webservices.ecommerce.web.servlets.AuthServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>XeroPdfServlet</servlet-name>
    <servlet-class>edu.ucla.library.libservices.webservices.ecommerce.web.servlets.XeroPdfServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoggingServlet</servlet-name>
    <url-pattern>/loggingservlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PaymentServlet</servlet-name>
    <url-pattern>/paymentservlet</url-pattern>
  </servlet-mapping>
  <context-param>
    <param-name>uri.base</param-name>
    <param-value>https://%DOMAIN%.library.ucla.edu</param-value>
  </context-param>
  <context-param>
    <param-name>alma.base.fees</param-name>
    <param-value>https://api-na.hosted.exlibrisgroup.com/almaws/v1/users/</param-value>
  </context-param>
  <context-param>
    <param-name>alma.resource.fees</param-name>
    <param-value>/fees?status=ACTIVE&amp;apikey=</param-value>
  </context-param>
  <context-param>
    <param-name>cashnet.ip.one</param-name>
    <param-value>34.195.213.231</param-value>
    <!--param-value>63.144.247.36</param-value-->
    <!--param-value>66.111.104.148</param-value-->
  </context-param>
  <context-param>
    <param-name>cashnet.ip.two</param-name>
    <!--param-value>67.208.47.14</param-value-->
    <!--param-value>208.47.84.36</param-value-->
    <param-value>34.192.112.253</param-value>
  </context-param>
  <context-param>
    <param-name>cashnet.ip.three</param-name>
    <param-value>40.90.247.249</param-value>
  </context-param>
  <context-param>
    <param-name>datasource.almadb</param-name>
    <param-value>jdbc/almaDS</param-value>
  </context-param>
  <context-param>
    <param-name>user.logging.cashnet</param-name>
    <param-value>ecommerce</param-value>
  </context-param>
  <context-param>
    <param-name>xero.tokens</param-name>
    <param-value>/usr/local/share/applications/xero/secrets.txt</param-value>
  </context-param>
  <context-param>
    <param-name>lpo.secrets</param-name>
    <param-value>/usr/local/share/applications/xero/lpo.props</param-value>
  </context-param>
  <servlet-mapping>
    <servlet-name>TestServlet</servlet-name>
    <url-pattern>/testservlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PdfServlet</servlet-name>
    <url-pattern>/pdfservlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/authservlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>XeroPdfServlet</servlet-name>
    <url-pattern>/xeropdfservlet</url-pattern>
  </servlet-mapping>
  <resource-ref>
    <description>DB Connection</description>
    <res-ref-name>jdbc/almaDS</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
</web-app>